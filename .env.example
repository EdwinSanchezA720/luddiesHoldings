# ══════════════════════════════════════════════════════════════════
# Luddies Holdings — Variables de entorno
# ══════════════════════════════════════════════════════════════════
#
# INSTRUCCIONES:
#   1. Copia este archivo como .env en la raíz del proyecto
#   2. Llena los valores con tus credenciales reales
#   3. .env está en .gitignore — nunca se sube al repositorio
#
# ESTADO ACTUAL:
#   El frontend es HTML/CSS/JS puro sin bundler.
#   Las variables de EmailJS se gestionan en client/js/config.js
#   (ver config.example.js como referencia).
#
#   Cuando el backend Spring Boot esté activo, estas variables
#   serán inyectadas por el servidor y los módulos de JS
#   dejarán de llamar a EmailJS directamente.
# ══════════════════════════════════════════════════════════════════


# ── EmailJS (frontend — temporal hasta activar backend) ───────────
# Estas keys también viven en client/js/config.js mientras no
# exista un proxy backend que las proteja del lado del servidor.

EMAILJS_PUBLIC_KEY_CONTACT=
EMAILJS_SERVICE_ID_CONTACT=
EMAILJS_TEMPLATE_ID_CONTACT=

EMAILJS_PUBLIC_KEY_PAYMENT=
EMAILJS_SERVICE_ID_PAYMENT=
EMAILJS_TEMPLATE_ID_PAYMENT=


# ── Backend Spring Boot (pendiente) ──────────────────────────────
# Descomentar y llenar cuando el servidor esté activo.

# APP_PORT=8080
# APP_ENV=development

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=luddies_db
# DB_USER=
# DB_PASSWORD=

# JWT_SECRET=
# JWT_EXPIRATION_MS=86400000


# ── Stripe (pendiente — reemplazará el stub de pago) ─────────────
# STRIPE_PUBLIC_KEY=pk_test_
# STRIPE_SECRET_KEY=sk_test_
# STRIPE_WEBHOOK_SECRET=whsec_


# ── Correo transaccional backend (pendiente) ─────────────────────
# Cuando el backend envíe correos directamente, EmailJS
# quedará obsoleto y estas vars tomarán su lugar.

# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@luddiesholdings.com
