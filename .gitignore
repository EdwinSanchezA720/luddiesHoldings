# ══════════════════════════════════════════════════════════════════
# Luddies Holdings — .gitignore
# ══════════════════════════════════════════════════════════════════


# ── Dependencias ─────────────────────────────────────────────────
node_modules/


# ── npm / yarn / pnpm ────────────────────────────────────────────
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak


# ── Secretos y entorno ───────────────────────────────────────────
# .env y todas sus variantes quedan fuera del repo.
# Usa .env.example como referencia de qué variables se necesitan.
.env
.env.*
!.env.example

# config.js contiene las keys reales de EmailJS para el frontend.
# Usa client/js/config.example.js como referencia.
client/js/config.js


# ── Caché ────────────────────────────────────────────────────────
.cache/


# ── Logs y tests ─────────────────────────────────────────────────
logs/
*.log
coverage/
.nyc_output/


# ── Build ────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo


# ── Sistema operativo ────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini


# ── IDE ──────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~
